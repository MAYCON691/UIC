# ===== Copia este archivo a ".env" EN EL SERVIDOR y completa los valores =====
# Nunca subas el ".env" real a GitHub.

# IP (o dominio) con la que los usuarios abren la app en el navegador
SERVER_HOST=172.16.100.59

# Puertos publicados en el servidor (elige otros si ya estan en uso)
FRONTEND_PORT=3100
BACKEND_PORT=4100

# Base de datos (usa solo letras y numeros en la clave)
POSTGRES_USER=uic
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=uicbase

# Seguridad: JWT_SECRET de 32 caracteres o mas
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=12h

# Superadmin inicial (se crea solo la primera vez)
SUPERADMIN_USER=CAMBIAR
SUPERADMIN_PASSWORD=CAMBIAR

# Subidas (en MB)
MAX_FILE_SIZE_MB=2000

# Dejar vacio si no hay nginx/Traefik delante; poner 1 si lo hay
TRUST_PROXY=